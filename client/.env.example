# --- Supabase (required) ---------------------------------------------------
# Get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- TURN server (optional, recommended for cross-NAT calls) ----------------
# Sign up free at https://www.metered.ca/tools/openrelay/ (50 GB/mo free)
# VITE_TURN_URL=turn:openrelay.metered.ca:80
# VITE_TURN_USER=openrelayproject
# VITE_TURN_CRED=openrelayproject
