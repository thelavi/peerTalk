{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!assets/|favicon\\.ico|.*\\.(?:js|css|map|svg|png|jpg|jpeg|gif|webp|ico|woff2?)).*)",
      "destination": "/"
    }
  ]
}
